# ---------------------------------------------------------------------------
# Public example only - contains NO real credentials.
# Copy to .env (or run scripts/bootstrap) before starting the stack.
# .env is gitignored; never commit it.
# ---------------------------------------------------------------------------

# HTTP port exposed on 127.0.0.1 only.
HTTP_PORT=8080

# Build-time option: 1 = also install the CodeQL CLI (~400 MB) plus JDK/Maven for
# Java deep analysis. 0 (default) keeps the image smaller and the build much faster;
# the CodeQL scanner then simply reports "unavailable" in the UI.
INSTALL_CODEQL=0

# sqlite (default, no external database) | mysql (enable `--profile mysql`)
# WARNING: enabling mysql requires setting strong MYSQL_PASSWORD / MYSQL_ROOT_PASSWORD below;
# docker-compose.yml ships weak `change-me*` fallbacks for local convenience only.
DATABASE_BACKEND=sqlite
# MYSQL_HOST=mysql
# MYSQL_PORT=3306
# MYSQL_USER=ai_audit
# MYSQL_PASSWORD=
# MYSQL_DATABASE=ai_audit
# MYSQL_ROOT_PASSWORD=

# --- Required when AUTH_ENABLED=true (backend refuses to start otherwise) ---
AUTH_ENABLED=true
AUTH_USERNAME=admin
# bootstrap generates a strong random value for both fields below.
AUTH_PASSWORD=
AUTH_SECRET_KEY=
AUTH_TOKEN_EXPIRE_HOURS=12
# CORS_ORIGINS is a JSON list; the built-in default already covers 127.0.0.1:8080.

# --- LLM audit (optional; leave empty to disable AI features) ---
LLM_ENABLED=false
LLM_CODE_AUDIT_ENABLED=false
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=openai

# --- GitLab / webhook (optional) ---
GITLAB_DEFAULT_URL=https://gitlab.com
GITLAB_ACCESS_TOKEN=
WEBHOOK_TOKEN=

# --- Notifications / SSO (optional) ---
FEISHU_WEBHOOK_URL=
SMTP_PASSWORD=
SSO_ENABLED=false
SSO_CLIENT_SECRET=

# PDF report engine: auto | weasyprint | chrome
PDF_ENGINE=auto
