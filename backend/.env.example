# 公开示例文件：以下全部为占位符/注释，不含任何真实凭据。
# 复制为 .env 后自行填写；.env 已被 .gitignore 忽略，切勿提交。
# APP_PORT=8787
# APP_HOST=0.0.0.0
# DATA_DIR=/data
# AI_AUDIT_ENV_FILE=/app/.env   # optional: mount a host .env here so UI changes survive rebuilds

# Database (local dev: sqlite or ai_audit_dev; production: ai_audit_prod — separate instances)
# DATABASE_BACKEND=sqlite
# DATABASE_URL=
# DATABASE_BACKEND=mysql
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=ai_audit
# MYSQL_PASSWORD=
# MYSQL_DATABASE=ai_audit_dev
# MYSQL_CHARSET=utf8mb4

# Login (change before exposing to LAN)
# AUTH_ENABLED=true
# AUTH_USERNAME=admin
# AUTH_PASSWORD=replace-with-a-strong-password
# AUTH_SECRET_KEY=<generate-at-least-32-random-chars>
# AUTH_TOKEN_EXPIRE_HOURS=12
# MAX_UPLOAD_BYTES=52428800
# Local password login is always treated as admin (break-glass).
# SSO users get role from GET {SSO_BASE_URL}/oauth/userinfo (roles/role containing "admin").

# SSO OAuth2 (optional)
# SSO_ENABLED=false
# SSO_BASE_URL=https://sso.example.com
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_REDIRECT_URI=https://your-host/api/auth/sso/callback
# FRONTEND_BASE_URL=https://your-host
# See docs/SSO_RBAC_HANDOFF.md for SSO role field requirements.

# LLM (required for FP audit / endpoint audit / PoC)
# LLM_API_KEY=replace-with-your-own-api-key
# LLM_API_BASE=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_ENABLED=true              # 扫描后自动 SAST 误报审计（含 webhook）
# LLM_CODE_AUDIT_ENABLED=true  # 扫描后自动 LLM 端点审计（含 webhook；耗时长）

# Feishu notification (optional)
# FEISHU_WEBHOOK_URL=
# FRONTEND_BASE_URL=http://localhost:8080

# GitLab + Jenkins webhook (CI SAST trigger)
# GITLAB_DEFAULT_URL=https://gitlab.example.com
# GITLAB_ACCESS_TOKEN=          # required for POST /api/webhooks/scan clone
# GITLAB_DEFAULT_BRANCH=main
# WEBHOOK_TOKEN=               # header X-Webhook-Token
# Keep LLM_ENABLED / LLM_CODE_AUDIT_ENABLED false for CI gate; enable in UI for auto LLM on all scans

# Host scanner tools mounted into container at /host-tools (Linux ELF binaries)
# HOST_TOOLS_DIR=./.host-tools
# WSL example: HOST_TOOLS_DIR=//wsl$/Ubuntu/home/you/ai-audit-tools
# OSV_SCANNER_PATH=/host-tools/bin/osv-scanner

# PDF report engine
#   auto       = WeasyPrint if usable, otherwise fall back to headless browser (default)
#   weasyprint = WeasyPrint only (needs GTK/Pango + CJK fonts installed)
#   chrome     = headless browser only
# PDF_ENGINE=auto
# Explicit browser path. Leave empty to auto-detect Chrome/Chromium/Edge from PATH
# and the usual install locations.
# PDF_CHROME_PATH=
# Timeout in seconds for headless-browser PDF rendering.
# PDF_CHROME_TIMEOUT=180
